{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["lastVerified", "projects"],
  "properties": {
    "lastVerified": { "type": "string", "format": "date" },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repository", "name", "slug", "summary", "category", "technologies", "status", "featuredPriority", "demoUrl", "architectureUrl", "evidenceUrl", "limitations", "evidenceSources"]
      }
    }
  }
}
